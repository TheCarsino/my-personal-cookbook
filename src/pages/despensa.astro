---
import Base from '../layouts/Base.astro';
import Checklist from '../components/Checklist.astro';
import WeekShop from '../components/WeekShop.astro';
import { plan, toneStyle, WEEK_TONE, CAT_TONE, base } from '../lib/plan';

const m = plan.pantry.month;
const monthStores = m.shop.map((s) => ({
  title: s.store,
  tag: s.day,
  icon: s.store === 'El mercado' ? 'basket' : 'cart',
  cost: s.costBase.label,
  sections: s.sections,
}));
const monthCosts = [
  { label: 'Compra del mes', value: `aprox. ${m.cost.base.label}`, strong: true },
  { label: 'Opcionales y de una sola vez', value: `hasta S/ ${m.cost.extras.max}` },
];
const MONTH_TONE = CAT_TONE.dulces;
---
<Base title="Despensa" active="despensa" description="Compras del mes y compra de frescos de cada semana, con costo aproximado.">
  <section class="wrap hero">
    <h1>Despensa</h1>
    <p class="lede">Una compra grande al inicio del mes y los frescos cada sábado. Precios aproximados en Lima, para 2 personas.</p>
  </section>

  <nav class="shopnav" aria-label="Listas de compras">
    <div class="wrap">
      <ul>
        <li><a href="#mes" style={toneStyle(MONTH_TONE)}><small>Compras</small><b>del mes</b></a></li>
        {plan.weeks.map((w) => (
          <li><a href={`#semana-${w.n}`} style={toneStyle(WEEK_TONE[w.n])}><small>Semana</small><b>{w.n}</b></a></li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="wrap">
    <div class="section shop-sec" id="mes" style={toneStyle(MONTH_TONE)}>
      <Checklist listKey="mes" title="Compras del mes" headingId="h-mes" stores={monthStores} costs={monthCosts}>
        <p class="shop-sub">Un solo viaje al inicio del mes; cubre las 4 semanas.</p>
      </Checklist>
    </div>

    {plan.weeks.map((w) => (
      <div class="section shop-sec" id={`semana-${w.n}`} style={toneStyle(WEEK_TONE[w.n])}>
        <WeekShop week={w} title={`Semana ${w.n}`} headingId={`h-semana-${w.n}`}>
          <p class="shop-sub">Frescos del sábado. <a href={base(`/semana/${w.n}/`)}>Ver el menú</a></p>
        </WeekShop>
      </div>
    ))}
  </div>
</Base>
