---
import Base from '../layouts/Base.astro';
import WeekBoard from '../components/WeekBoard.astro';
import Icon from '../components/Icon.astro';
import { plan, WEEK_TONE, toneStyle, base } from '../lib/plan';
---
<Base title="Inicio" active="inicio">
  <section class="wrap hero">
    <h1>Sábado se compra, domingo se cocina.</h1>
    <p class="lede">De lunes a viernes: desayuno, almuerzo en táper, un dulce y una cena de 15 minutos. Cuatro semanas para 2 adultos.</p>
    <ul class="jump">
      {plan.weeks.map((w) => (
        <li>
          <a href={`#semana-${w.n}`} style={toneStyle(WEEK_TONE[w.n])}>
            <span class="n">Semana {w.n}</span>
            <span class="t">{w.theme}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {plan.weeks.map((w) => (
    <section class="week-block" id={`semana-${w.n}`} style={toneStyle(WEEK_TONE[w.n])} aria-labelledby={`h-s${w.n}`}>
      <div class="wrap">
        <div class="wb-head">
          <div>
            <h2 id={`h-s${w.n}`}>Semana {w.n}</h2>
            <p class="theme">{w.title}</p>
          </div>
          <a class="btn" href={base(`/semana/${w.n}/`)}>Ver día por día y lista</a>
        </div>

        <div class="panel">
          <h3>Menú de lunes a viernes</h3>
          <WeekBoard week={w} />
        </div>

        <div class="two">
          <div class="panel">
            <h3>Ingredientes clave</h3>
            <div class="ing-groups">
              {w.keyIngredients.map((g) => (
                <div>
                  <h4>{g.group}</h4>
                  <ul class="chips">
                    {g.items.map((i) => <li class="chip">{i}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </div>
          <div class="panel">
            <h3>Ritmo de la semana</h3>
            <ul class="rhythm" style="grid-template-columns:1fr">
              <li><span class="ico"><Icon name="cart" /></span><div><b>Sábado: compra</b>{w.rhythm.sabado}</div></li>
              <li><span class="ico"><Icon name="pot" /></span><div><b>Domingo: cocina</b>{w.rhythm.domingo}</div></li>
              <li><span class="ico"><Icon name="basket" /></span><div><b>Miércoles: reposición</b>{w.rhythm.miercoles}</div></li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}
</Base>
